DOCKERHUB_USERNAME=your-dockerhub-username
JWT_SECRET_KEY=change-me-please-use-a-32-char-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
SENTRY_DSN=www.email.com
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_SEND_DEFAULT_PII=true
POSTGRES_USER=postgres
POSTGRES_DB=lumen
POSTGRES_PASSWORD=change-me-please-use-a-strong-password
BACKEND_PORT=9000
FRONTEND_PORT=3000
S3_BUCKET_NAME=texai-bucket
S3_REGION=us-east-1
# Local development runs an S3-compatible service in compose instead of real
# AWS, and it ignores credentials -- but boto3 will not sign a request without
# them, so they cannot be blank. Put real keys here only if you also empty both
# endpoints below.
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local-secret
# Where the API reaches object storage. Empty means real AWS. The compile
# worker runs on the HOST, where 's3' does not resolve, so it must override
# this with http://localhost:9100 -- see SETUP.md stage 3c.
S3_ENDPOINT_URL=http://s3
# The same service as the BROWSER sees it. A presigned URL signs its own Host
# header, so uploads fail with SignatureDoesNotMatch if this is the internal
# name instead of the published one.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9100
# Only needed when running the frontend outside Docker (prod compose sets it).
BACKEND_URL=http://localhost:9000

# Compilation. The worker runs on the host, not in compose, because it drives
# the Docker daemon directly -- see "Compiling locally" in CLAUDE.md.
# Build the image first: cd compile && docker build -t lumen-tex:latest .
TEX_IMAGE=lumen-tex:latest
COMPILE_TIMEOUT_SECONDS=300
COMPILE_MAX_CONCURRENT_PER_USER=2
# Required in production. Snap-installed Docker cannot exec with it set, so set
# it empty for local work on such a host -- and only there.
COMPILE_SECURITY_OPT=--security-opt=no-new-privileges

# Imported zips. The compressed ceiling bounds one request; the uncompressed
# ones bound what a zip bomb can turn it into.
ARCHIVE_MAX_BYTES=52428800
ARCHIVE_MAX_TOTAL_BYTES=209715200
ARCHIVE_MAX_ENTRIES=2000

# Bounded so a runaway document cannot exhaust the API or kill the tab.
COMPILE_LOG_MAX_BYTES=2097152
# How long a job may sit unclaimed before the API says nothing will take it.
COMPILE_QUEUE_TIMEOUT_SECONDS=120
